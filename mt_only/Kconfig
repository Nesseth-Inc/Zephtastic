config MT_PKI_STOCK_TRIAL
	bool "Bounded multi-peer stock PKI with explicit USB administration"
	default n
	depends on BOARD_HELTEC_T096 && MT_NORMAL_ENDPOINT && MT_ALLOW_TX && MT_NORMAL_TX_DEFAULT
	depends on SETTINGS_NVS && (BT || MT_T096_ROUTER_ONLY) && PSA_CRYPTO
	select MT_PKI_TARGET_RUNTIME
	help
	  T096 qualification profile using the common private runtime. Empty
	  private storage permits local USB but holds RF. When legacy setup tools
	  are enabled, same-session USB stage/commit may create the initial local
	  identity and first peer. Normal operation preserves that identity and
	  the global nonce authority; compact contacts support live owner updates
	  and verified RF peer adoption without rebuilding sibling sessions.
	  Active startup may honor normal TX intent. Storage migration, recovery
	  compatibility and hardware qualification remain explicit boundaries.

config MT_PKI_LEGACY_TAIL_TOOLS
	bool "Legacy PKI setup, upgrade and recovery USB tools"
	depends on MT_PKI_STOCK_TRIAL
	default y
	help
	  Retain fresh identity setup over local CDC, one-time legacy storage/lifecycle
	  upgrades, explicit compact-contact migration and USB peer-add maintenance,
	  and former-code tail, spare-partition, and capacity diagnostics for recovery
	  images. Disabling this option omits those setup/maintenance commands; it does
	  not change loading of an existing identity or compact-contact directory,
	  ledger normalization, append-history capacity, automatic owner-contact and
	  verified RF peer adoption, or ordinary lifecycle/ledger status.
	  Existing profiles retain these tools unless an explicit build fragment opts
	  out. Fresh initial setup remains available in a recovery image built with
	  this option enabled. Use a recovery image built from a source revision
	  compatible with the stored contact and history formats.

config MT_PKI_EXTENDED_DIAGNOSTICS
	bool "Extended USB diagnostics for development and recovery"
	default y
	help
	  Include extended radio, private-reply, settings-save, storage and
	  channel diagnostic records in the local USB handshake. The normal
	  health and endpoint records and the read-only PKI contacts, lifecycle,
	  and limits status commands remain available when this is disabled.
	  Disable in the constrained production profile; retain in development
	  and full-tools recovery profiles.

config MT_PKI_COMPACT_RUNTIME_ONLY
	bool "Require provisioned compact PKI runtime at boot"
	depends on MT_PKI_STOCK_TRIAL && !MT_PKI_LEGACY_TAIL_TOOLS
	default n
	help
	  Omit legacy identity/ledger runtime fallback from the normal T096 profile.
	  Boot requires the identity-bound, fully replayed immutable append root,
	  activated bounded nonce counter, and a valid adjacent compact-contact pair.
	  Missing, legacy-only, partial, or mismatched state fails closed without
	  repair or migration. Use a compatible recovery image for initial setup and
	  migration. The default keeps the existing stock-compatible runtime.

config MT_PKI_FRESH_DOMAIN_ONLY
	bool "T096 extended application with fresh NVS-backed PKI only"
	depends on BOARD_HELTEC_T096 && MT_PKI_COMPACT_RUNTIME_ONLY
	default n
	help
