config MT_ALLOW_TX
	bool "Compile the bounded RF transmission path"
	default n
	help
	  Normal-use or explicit owner-test builds only. This gate alone never arms
	  TX and RX-only builds leave it disabled.
	  T096 is fixed at the lowest SX1262 drive; antenna output is uncalibrated.
config MT_NORMAL_ENDPOINT
	bool "Bounded primary-channel messaging engine"
	default y
	help
	  Four pending messages and bounded ACK/retry state. MT_ALLOW_TX remains
	  a separate disabled release gate. Disable for legacy one-packet tests.
config MT_T096_ROUTER_ONLY
	bool "T096 headless router with USB administration"
	depends on BOARD_HELTEC_T096 && !BT
	default n

config MT_T096_OWNER_TX
	bool "Owner-authorized T096 TX at fixed lowest chip drive"
	depends on BOARD_HELTEC_T096 && MT_ALLOW_TX && MT_NORMAL_ENDPOINT
	default n
	help
	  This deliberate opt-in retains the fixed -9 dBm chip-drive request, which
	  is not calibrated antenna power. Region and protocol guards remain fixed.
config MT_NORMAL_TX_DEFAULT
	bool "Normal companion TX enabled unless explicitly disabled"
	depends on MT_ALLOW_TX && MT_NORMAL_ENDPOINT
	default n
	help
	  Normal-use profile policy. A provisioned legacy record is migrated to an
	  explicit durable enable before RX/TX starts. A later explicit local LoRa
	  disable persists and overrides this default. Diagnostic and RX-only
	  profiles leave this option off.
config MT_PKI_GROUNDWORK
	bool "Compile/link inactive private-message crypto groundwork"
	default n
	depends on PSA_CRYPTO
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_ALG_CCM
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_KEY_TYPE_AES
	help
	  Target link evidence only. No runtime caller, persistent credentials,
	  identity migration, nonce provider or PKI capability advertisement.
config MT_PKI_TARGET_RUNTIME
	bool "Experimental load-only private runtime (unqualified)"
	default n
	depends on MT_NORMAL_ENDPOINT && SETTINGS_NVS && (BT || MT_T096_ROUTER_ONLY) && PSA_CRYPTO
	depends on SOC_NRF52840 || SOC_SERIES_ESP32S3
	select MT_PKI_GROUNDWORK
	select MT_SHARED_MBEDTLS_THREADING
	help
	  Load an already provisioned local identity, up to sixteen durable peer
	  contacts and four hot sessions. Never creates a local identity or imports
	  private credentials. With ready compact storage, canonical local owner
	  contacts may configure destination keys; verified signed RF NodeInfo may
	  add peers through the serialized storage barrier. NodeCache alone cannot
	  grant trust. TX follows existing profile/configuration intent; invalid
	  private state holds RF disabled. Provisioning and hardware resource,
	  entropy and interoperability qualification remain separate requirements.
config MT_STOCK_IDENTITY_IMPORT
    bool
    default y if BOARD_XIAO_ESP32S3 && BOOTLOADER_MCUBOOT && MT_PKI_TARGET_RUNTIME && !MT_XIAO_EXPANDED_CONTACTS
    help
      Include the local USB-consented stock identity migration protocol.
      It is disabled at boot and every new USB session until an explicit arm.

config MT_XIAO_EXPANDED_CONTACTS
	bool "XIAO signed companion with 198 explicitly trusted contacts"
	depends on BOARD_XIAO_ESP32S3 && ESP_SPIRAM && MT_PKI_TARGET_RUNTIME && FLASH_MAP
	depends on MT_SIGNED_BLE_OTA && MT_STORE_FORWARD_PSRAM && $(dt_nodelabel_enabled,mt_pki_contacts_partition)
	default n
