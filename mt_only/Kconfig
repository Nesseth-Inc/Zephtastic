mainmenu "ZephTastic standalone companion"
config MT_HARDWARE_MODEL
    int "Meshtastic hardware model (0 selects the board default)"
    range 0 255
    default 0
    help
      A board or carrier overlay can select its published Meshtastic 2.8.2
      HardwareModel number here. Use 255 for a private port. An unrecognized
      board with the default setting reports UNSET. This option changes the
      reported identity only. Radio drivers and updater images must match
      the physical board.

config MT_NORDIC_DFU
	bool "T096 Nordic DFU handoff (provisioned compatible bootloader required)"
	depends on BOARD_HELTEC_T096 && BT
	default n
	help
	  Opt in only when the installed UF2 partition contains the documented,
	  board-compatible Nordic bootloader that consumes the GPREGRET mode values
	  used by this application. The runtime pointer/vector probe proves only
	  executable plausibility, not loader identity or protocol compatibility.
	  No loader is installed and no reserved SoftDevice peer-data RAM is written.
config MT_SIGNED_WIFI_OTA
    bool "Owner-authorized stock TCP OTA for signed XIAO companion slots"
    depends on BOARD_XIAO_ESP32S3 && MT_WIFI_STATION && BOOTLOADER_MCUBOOT
    depends on !MT_ESP_STOCK_OTA_LOADER
    help
      Accept one preauthorized image hash using the Meshtastic unified TCP
      update protocol on a configured station. Requires the dedicated signed
      bootloader and first-install flash map.
config MT_ESP_STOCK_OTA_LOADER
	bool "Existing ESP-IDF stock Meshtastic OTA loader bridge"
	depends on BOARD_XIAO_ESP32S3
	default n
	help
	  Requires separately supplied ESP-IDF app_update, esp_partition and NVS
	  APIs, plus an already provisioned compatible OTA_0/OTA_1/otadata/NVS
	  partition layout. This does not provision a loader, initialize NVS,
	  erase flash or repartition the current Zephyr device. A runtime probe
	  refuses absent/incompatible layouts. Current ordinary profiles keep it off.
config MT_TAK_TRACKER
	bool "Meshtastic TAK tracker position producer"
	default n
	depends on MT_NORMAL_ENDPOINT
	help
	  Optional TAK_TRACKER role, persistent team/role settings, and raw PLI
	  position broadcasts through the normal endpoint. Fresh/fixed position
	  and per-channel precision consent remain required.
config MT_GPIO_MODULES
	bool "Meshtastic RemoteHardware and DetectionSensor modules"
	default n
	depends on GPIO
	help
	  Optional module settings and bounded runtime using an explicit GPIO
	  export table. Existing board aliases are never implicitly exported.
	  Without a reviewed table both modules remain operationally unavailable.
config MT_SERIAL_MODULE
	bool "Meshtastic dedicated UART module"
	select REQUIRES_FLOAT_PRINTF
	default n
	depends on SERIAL
	help
	  Uses a dedicated enabled mt-serial devicetree alias with board pinctrl.
	  The companion console and GNSS UART cannot be reused by this adapter.
	  Supports stock baud selection/byte timeout, SIMPLE/TEXTMSG, framed
	  PROTO, NMEA/CalTopo output and WS85 weather input. Module configuration
	  remains disabled by default; Heltec Solar-only MS_CONFIG is absent.
config MT_WIFI_STATION
	bool "ZephCore WiFi station with local Meshtastic configuration"
	default n
	depends on BOARD_XIAO_ESP32S3 && WIFI && NETWORKING
	depends on NET_IPV4 && NET_DHCPV4 && NET_MGMT && NET_MGMT_EVENT
	depends on NET_MGMT_EVENT_INFO
	help
	  Explicit WiFi-capable build only. Disabled defaults never associate.
	  Reuses ZephCore reconnect/backoff and optional SNTP; boot owns immutable
	  credential buffers. Local verified settings take effect after reboot.
	  DHCP readiness is separate from successful time synchronization.
config MT_TCP_COMPANION
	bool "Meshtastic TCP companion on port 4403"
	default n
	depends on MT_WIFI_STATION && NET_SOCKETS && NET_TCP && ESP_SPIRAM
	help
	  Single LAN client, bounded queues and a separate socket owner. Reuses
	  ZephCore transport primitives with Meshtastic framing and a third local
	  endpoint owner. No socket starts without verified enabled WiFi policy.
config MT_BROWSER_MESSAGING
	bool "Same-origin browser messaging on the joined WiFi station"
	default n
	depends on MT_TCP_COMPANION && CSPRNG_ENABLED
	help
	  Serves the onboard messaging page and the stock protobuf polling API on
	  HTTP port 80. A local-subnet browser shares the existing TCP companion
	  owner exclusively. Only text and sanitized discovery reach this endpoint.
# Both listeners, Wi-Fi services and recently closed peers share these pools.
# Supply browser defaults before the Zephyr IPv4-only defaults (4 and 6).
config NET_MAX_CONN
	int
	default 12 if MT_BROWSER_MESSAGING

config NET_MAX_CONTEXTS
	int
	default 12 if MT_BROWSER_MESSAGING

config MT_MQTT_GATEWAY
	bool "Meshtastic MQTT gateway"
	default n
	depends on BOARD_XIAO_ESP32S3 && MT_WIFI_STATION && NET_SOCKETS && NET_TCP && ESP_SPIRAM
	depends on MQTT_LIB && MQTT_LIB_TLS
	select MT_SHARED_MBEDTLS_THREADING
	help
	  Optional WiFi/PSRAM uplink and admitted downlink. A worker owns DNS,
	  socket IO, polling, TLS, and reconnects. Bounded payload queue resides in
	  external PSRAM; T096 and ordinary XIAO builds have no MQTT worker/storage.
	  TLS requires an explicitly configured CA security tag and verifies hostname.
config MT_M119_TLS_TEST
	bool "M119 test-only authenticated WiFi MQTT TLS canary"
	default n
	depends on MT_WIFI_STATION && MT_MQTT_GATEWAY && TLS_CREDENTIALS_BACKEND_VOLATILE
	depends on MQTT_LIB_TLS
	depends on !MT_PKI_TARGET_RUNTIME
	help
	  Temporary test-only CA provisioning and scalar MQTT status for the M119
	  WiFi TLS canary. Requires Root-generated public CA fixture bytes. No
	  default fixture or insecure fallback exists. Never enable in release,
	  T096, or ordinary XIAO profiles.

